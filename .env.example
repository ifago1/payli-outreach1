# Database (SQLite default, easy om naar Postgres te schakelen)
DATABASE_URL="file:./prisma/dev.db"

# KVK API
# Test API base URL (gratis sandbox via developers.kvk.nl)
KVK_API_BASE_URL="https://api.kvk.nl/test/api/v2"
# Publieke KVK test-key (sandbox) — werkt direct, geen aanvraag nodig.
# Voor PRODUCTIE: vervang door je eigen key EN zet KVK_API_BASE_URL op https://api.kvk.nl/api/v2
KVK_API_KEY="l7xx1f2691f2520d487b902f4e0b57a0b197"

# Sync defaults
# Aantal dagen terug om als "nieuwe inschrijving" te beschouwen
SYNC_NEW_BUSINESS_WINDOW_DAYS="60"
# Maximaal aantal profielen per sync run (KVK rate limit guard)
SYNC_MAX_PROFILES_PER_RUN="200"
# Let op: elk vestigingsnummer dat we al kennen (als lead of als eerdere
# afwijzing) wordt permanent overgeslagen — we halen een profiel dus nooit
# twee keer op. Wil je een vestiging herbeoordelen, draai dan een sync in
# testmodus (negeert beide caches).
# Cron secret om /api/sync/cron te beschermen
SYNC_CRON_SECRET="change-me"

# HTTP Basic Auth om de hele app af te schermen.
# Leeg laten = geen authenticatie (dev). Vul beide in om login te activeren.
# /api/sync/cron blijft beschermd door SYNC_CRON_SECRET (zie hierboven).
BASIC_AUTH_USER=""
BASIC_AUTH_PASSWORD=""

# SMTP voor outbound e-mails (Resend/Postmark/SendGrid/Mailgun — elk SMTP-endpoint werkt)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Payli <hello@payli.nl>"
